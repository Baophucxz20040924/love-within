# ── App, CI and explicitly allowed verification sources ─
# Everything else at the repo root is ignored (plan/, spec/, infra/, README.md, secret.md, notes...)
/*
!/.gitignore
!/.github/
!/backend/
!/frontend/

# Focused browser regression source; tooling/evidence remain external.
!/scripts/
/scripts/*
!/scripts/browser/
/scripts/browser/*
!/scripts/browser/harness.mjs
!/scripts/browser/daily-rewards-water.mjs
!/scripts/browser/history-pages.mjs
!/scripts/browser/friend-comment-pages.mjs
!/scripts/browser/scam-game.mjs
!/scripts/browser/README.md

# ── Inside backend/ and frontend/ ──────────────────────────────────────
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Secrets / env (the .example files stay)
.env
.env.*
!/backend/.env.example
!/frontend/.env.example
*.env
*.pem
*.key

# Dev-only helper scripts and notes: not needed to build or run
backend/scripts/*
!backend/scripts/bootstrap-admin.ts
!backend/scripts/measure-daily-activities.cjs
backend/README.md
frontend/README.md

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

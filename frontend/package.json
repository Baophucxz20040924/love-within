{
  "name": "look-within-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:realtime": "node tests/realtime/realtime.cjs",
    "test:realtime:browser": "node tests/realtime/browser.mjs",
    "test:mentions": "node tests/post-mentions/mentions.cjs",
    "test:mentions:browser": "node tests/post-mentions/browser.mjs",
    "test:media": "node tests/post-media/media.cjs && node tests/post-media/upload.cjs && node tests/post-media/player.cjs && node tests/post-media/composer.cjs",
    "test:media:browser": "node tests/post-media/browser.mjs",
    "test:privacy": "node --test tests/privacy/store.cjs",
    "test:privacy:browser": "node tests/privacy/browser.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tanstack/react-query": "5.59.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}

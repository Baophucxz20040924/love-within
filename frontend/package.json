{
  "name": "look-within-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:app-lock": "node tests/app-lock/store.cjs && node tests/app-lock/tokens.cjs && node tests/app-lock/pin-entry.cjs && node scripts/test-auth-storage.cjs",
    "test:app-lock:browser": "node tests/app-lock/browser.mjs --local-mock-runtime",
    "test:realtime": "node tests/realtime/realtime.cjs",
    "test:realtime:browser": "node tests/realtime/browser.mjs",
    "test:reactions": "node tests/reactions.cjs",
    "test:reactions:browser": "node tests/reactions/browser.mjs --local-mock-runtime",
    "test:mentions": "node tests/post-mentions/mentions.cjs",
    "test:mentions:browser": "node tests/post-mentions/browser.mjs",
    "test:event-mentions": "node tests/event-mentions/event.cjs",
    "test:event-mentions:browser": "node tests/event-mentions/browser.mjs --local-mock-runtime",
    "test:moments": "node tests/moments.cjs",
    "test:moments:browser": "node tests/moments/browser.mjs --local-mock-runtime",
    "test:media": "node tests/post-media/media.cjs && node tests/post-media/upload.cjs && node tests/post-media/player.cjs && node tests/post-media/composer.cjs",
    "test:media:browser": "node tests/post-media/browser.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tanstack/react-query": "5.59.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}

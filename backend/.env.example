# Copy to .env. On the VPS this file lives at /opt/look-within/.env (see infra/DEPLOY.md). NEVER commit the real one.

# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=production
# Reverse proxies in front of the API: 1 = one proxy, 2 = CloudFront + Caddy (dev/prod on the VPS).
TRUST_PROXY_HOPS=2

# ── Docker deploy (only used by docker-compose.yml on the VPS) ─────────────────
# IMAGE is rewritten by the GitHub Action on every deploy.
IMAGE=ghcr.io/OWNER/REPO-backend:dev
# DNS name CloudFront calls (A record -> VPS IP). Must match terraform var api_origin_domain.
API_ORIGIN_DOMAIN=api-origin.dev.example.com
# Must match terraform var origin_verify_secret (CloudFront sends it as X-Origin-Verify). openssl rand -hex 24
ORIGIN_SECRET=

# ── MongoDB (Atlas) ────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/lookwithin_dev?retryWrites=true&w=majority

# ── Auth / JWT (>= 32 chars, different, no "change-me") ─
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── beeknoee (AI) ──────────────────────────────────────
BEEKNOEE_BASE_URL=https://platform.beeknoee.com
BEEKNOEE_API_KEY=sk-bee-YOUR_API_KEY
BEEKNOEE_MODEL=openai/gpt-4o-mini
BEEKNOEE_TIMEOUT_MS=20000
BEEKNOEE_CHAT_MODEL=openai/gpt-5.4-mini
BEEKNOEE_CHAT_TIMEOUT_MS=45000

# ── Provider switches (mock/memory are refused when NODE_ENV=production) ──
AI_PROVIDER=beeknoee
AI_CHAT_PROVIDER=beeknoee
STORAGE_PROVIDER=s3

# ── AWS S3 (photos). Values come from `terraform output` ──
AWS_REGION=ap-southeast-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MAX_UPLOAD_BYTES=5242880

# ── Ops ────────────────────────────────────────────────
MEM_WARN_MB=1500
SCHEDULER_ENABLED=true

# ── Web Push: npx web-push generate-vapid-keys ─────────
PUSH_PROVIDER=webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── CORS: the CloudFront URL of the frontend ───────────
CORS_ORIGIN=https://dev.example.com

# ── Bank cash flow ─────────────────────────────────────
BANK_PROVIDER=thueapibank
THUEAPIBANK_BASE_URL=https://thueapibank.vn
THUEAPIBANK_TIMEOUT_MS=15000
BANK_POLL_INTERVAL_SEC=120
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  (keep it once set)
BANK_TOKEN_ENC_KEY=

{
  "name": "look-within-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Look Within REST API (Node + Express + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:realtime": "node tests/realtime/run.cjs",
    "test:mentions": "node tests/post-mentions/story.test.cjs && node tests/post-mentions/repository.test.cjs && node tests/post-mentions/notification.test.cjs",
    "test:ai": "tsx scripts/test-ai.ts",
    "seed:couple": "tsx scripts/seed-couple.ts",
    "reports": "tsx scripts/reports.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "express-rate-limit": "7.4.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.24.8",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.9.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
